# Optional local overrides. Never place real credentials in this file.
NSE_ENGINE_CONFIG_DIR=config
NSE_ENGINE_LOG_LEVEL=INFO

# Phase 6: live trading stays disabled. These are environment variable NAMES,
# not credentials. Never put API keys, secrets, or TOTP seeds in this file.
# Groww API key (set only in your local environment)
# GROWW_API_KEY=
# Groww API secret (set only in your local environment)
# GROWW_API_SECRET=
# Groww TOTP seed (set only in your local environment)
# GROWW_TOTP_SEED=
# Explicit opt-in required alongside DRY_RUN=false; leave unset.
# LIVE_CONFIRM=
